        <ui:Button text="Çık" name="CloseButton" parse-escape-sequences="true" style="display: flex; background-size: 50% 100%; width: 319px; -unity-text-align: middle-center; white-space: pre; text-overflow: clip; left: 623px; font-size: 14px;"/>
    </ui:VisualElement>
