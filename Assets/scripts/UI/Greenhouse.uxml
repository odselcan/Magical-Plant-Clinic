<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="GreenhousePanel" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Sprite%20sheet/dialogue%20background-Photoroom.png?fileID=-5387889039486797097&amp;guid=86cdba416972c1b4297863eab526fef9&amp;type=3#dialogue background-Photoroom_0&quot;); height: 1081px; padding-bottom: 157px; padding-top: 245px; padding-left: 190px; padding-right: 153px;">
        <ui:VisualElement name="Header" style="flex-grow: 0;">
